{
  "definitions": [
    {
      "title": "Índice",
      "id": "indice",
      "model": "indice",
      "plugins": {
        "da": {
          "name": "indice",
          "unsafeHTML": "<div class=\"indice\"><div><div>Nesta página</div></div></div>",
          "fields": [
            {
              "name": "titulo",
              "selector": "div:nth-child(1)>div"
            },
            {
              "name": "links",
              "selector": "div:nth-child(2)>div"
            },
            {
              "name": "imagem",
              "selector": "div:nth-child(3)>div picture>img[src]"
            },
            {
              "name": "imagemAlt",
              "selector": "div:nth-child(3)>div picture>img[alt]"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "indice",
      "fields": [
        {
          "component": "text",
