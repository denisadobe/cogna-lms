        },
        {
          "component": "richtext",
          "name": "links",
          "label": "Links (vazio = gerado a partir dos títulos da página)",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "imagem",
          "label": "Imagem (opcional)",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imagemAlt",
          "label": "Texto alternativo",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": []
